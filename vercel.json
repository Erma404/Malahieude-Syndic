{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "malahieude-syndic.vercel.app"
        }
      ],
      "destination": "https://www.malahieude.fr/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "malahieude-syndic.vercel.app"
        }
      ],
      "destination": "https://www.malahieude.fr/:path*",
      "permanent": true
    }
  ]
}
